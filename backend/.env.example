DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
JWT_SECRET=change-me-to-a-long-random-string
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/auth/google/callback
GOOGLE_SIGNUP_EXPIRE_MINUTES=10

PASSWORD_RESET_EXPIRE_MINUTES=15
EMAIL_VERIFICATION_EXPIRE_HOURS=24

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@skillio.local

# Local/bootstrap admin seed — used by: python -m scripts.seed_admin
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Rate limiting (in-memory). Set TRUST_PROXY_HEADERS=true only behind a trusted proxy.
RATE_LIMIT_ENABLED=true
TRUST_PROXY_HEADERS=false
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_REGISTER_PER_MINUTE=5
RATE_LIMIT_FORGOT_PASSWORD_PER_MINUTE=3
RATE_LIMIT_RESEND_VERIFICATION_PER_MINUTE=3
RATE_LIMIT_RESET_PASSWORD_PER_MINUTE=5
RATE_LIMIT_GOOGLE_COMPLETE_PER_MINUTE=5

# Resume uploads (files stored under UPLOAD_DIR/resumes/)
UPLOAD_DIR=uploads
MAX_RESUME_SIZE_MB=5
MAX_ACTIVE_RESUMES=3
RESUME_UPLOAD_RATE_LIMIT=10/hour
